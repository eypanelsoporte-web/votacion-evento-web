# Apache (hosting compartido). Subir junto con el resto de los archivos.
# Solo se suben: ipad.html, tv.html, sw.js, .htaccess, assets/ y media/.
# NUNCA subir las carpetas sql/ ni dev/.

# --- Fuerza HTTPS (el service worker y la base de datos lo necesitan) ---
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

Options -Indexes

# --- Archivos que nunca deben servirse ---
<IfModule mod_authz_core.c>
  <FilesMatch "\.(sql|md|mjs|log|bak|env|map)$|^\.(?!well-known)">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  # Siempre revalidar codigo y paginas: las actualizaciones llegan solas.
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Politica de seguridad de contenido: solo se ejecuta codigo propio y solo se
  # habla con el servidor de la base de datos. Debe coincidir con la <meta> de
  # ipad.html y tv.html (lo verifica dev/auditoria-estatica.mjs).
  Header set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' https://*.supabase.co; media-src 'self' https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co; worker-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'"
  Header set Strict-Transport-Security "max-age=15552000"
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "DENY"
  Header set Referrer-Policy "no-referrer"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header set Cross-Origin-Opener-Policy "same-origin"
</IfModule>

AddType video/mp4 .mp4
AddType video/webm .webm
AddType image/webp .webp
AddType text/javascript .js
